# Produção: AGORA_RUNTIME_MODE=production é definido pelo compose.yml.
# Preencha as variáveis obrigatórias abaixo e nunca commite o .env real.
# DATABASE_URL deve apontar para Postgres persistente.
DATABASE_URL=
BETTER_AUTH_URL=https://news.automatizems.com
BETTER_AUTH_SECRET=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
VITE_AUTH_ENABLED=true

# Opcionais: origem Supabase customizada e Redis REST. Sem Redis, caches não
# críticos usam memória; o lease de ingest falha fechado se Redis for solicitado
# com um par URL/token incompleto.
SUPABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
